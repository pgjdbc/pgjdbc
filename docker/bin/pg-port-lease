#!/usr/bin/env bash
set -euo pipefail

# Leases host ports for the test PostgreSQL server of a git worktree: acquire, show, release, or addresses.
# The commands and the registry are described in docker/bin/PortLease.java, which this script runs
# as a single source file; it needs Java 17 or later on PATH.

exec java "$( cd "$( dirname "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )/PortLease.java" "$@"
