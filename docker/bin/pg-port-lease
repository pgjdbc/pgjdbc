#!/usr/bin/env bash
set -euo pipefail

# Leases host ports for the test PostgreSQL server of a git worktree.
#
# All worktrees of a repository share one registry in git refs: the ref
# refs/pgjdbc/ports/<slot> points to a blob that holds "<unix time> <worktree path>".
# Slot N owns ports 20000 + 3 * N, 20001 + 3 * N, and 20002 + 3 * N, for the primary
# server and two replicas, so the 3333 slots cover ports 20000 to 29998.
#
#    docker/bin/pg-port-lease acquire     - Print "<slot> <port> <port> <port>" for this worktree,
#                                           taking a slot if the worktree holds none
#    docker/bin/pg-port-lease show        - Print the same line if this worktree holds a slot
#    docker/bin/pg-port-lease release     - Give up the slot of this worktree
#    docker/bin/pg-port-lease addresses   - Print the addresses a server on leased ports listens on:
#                                           127.0.0.1, and ::1 when the host has an IPv6 loopback
#
# A slot is free when it has no ref, or when its worktree is missing from
# `git worktree list` or marked prunable there. When no slot is free, acquire takes
# the slot whose lease was renewed longest ago. acquire renews the lease of the
# worktree it runs in, and keeps that slot even while its ports are in use. A slot of
# another worktree, or a free slot, is not taken while one of its ports accepts
# connections on one of those addresses, or when one of its ports is on the list of
# well-known ports below.

readonly ref_prefix=refs/pgjdbc/ports
readonly first_port=20000
readonly slot_count=3333
# Ports in 20000-29998 that common services use: Syncthing, Fluentd, Minecraft, RabbitMQ,
# CockroachDB, Redis Sentinel, Steam, MongoDB, RethinkDB, and Kafka in Docker.
readonly skipped_ports="22000 24224 25565 25672 26257 26379 27015-27030 27017-27019 28015 29015 29092"

die () {
    echo "pg-port-lease: $*" 1>&2
    exit 1
}

# Prints 127.0.0.1, and ::1 when the host has an IPv6 loopback address, one per line. Docker
# refuses to publish a port on ::1 on a host without one, and the container does not start.
loopback_addresses () {
    echo 127.0.0.1
    if [[ -r /proc/net/if_inet6 ]]; then
        if grep -q '^00000000000000000000000000000001 ' /proc/net/if_inet6; then
            echo ::1
        fi
    elif ifconfig lo0 2> /dev/null | grep -q 'inet6 ::1 '; then
        echo ::1
    fi
}

slot_ports () {
    local base=$(( first_port + 3 * $1 ))
    echo "${base} $(( base + 1 )) $(( base + 2 ))"
}

# Succeeds when one of the ports of slot $1 accepts connections on one of the addresses in $2.
slot_ports_in_use () {
    local port address
    for port in $(slot_ports "$1"); do
        for address in $2; do
            if (exec 3<>"/dev/tcp/${address}/${port}") 2>/dev/null; then
                return 0
            fi
        done
    done
    return 1
}

# Prints the paths of the worktrees git does not consider prunable, one per line.
live_worktrees () {
    git worktree list --porcelain | awk '
        /^worktree / { if (path != "") print path; path = substr($0, 10) }
        /^prunable/ { path = "" }
        END { if (path != "") print path }'
}

# Prints "<slot> <object id> <unix time> <worktree path>" for every ref that points to a blob.
# The size of each object decides how many lines of content belong to it, so a ref to a commit
# or to a blob of several lines does not shift the refs after it.
list_leases () {
    git for-each-ref --format='%(objectname) %(refname)' "${ref_prefix}/" |
        git cat-file --batch='%(objectname) %(objecttype) %(objectsize) %(rest)' |
        LC_ALL=C awk '
            NF == 2 && $2 == "missing" { next }
            {
                oid = $1; type = $2; size = $3 + 0; slot = $4
                sub(/.*\//, "", slot)
                first = ""; consumed = 0
                while (consumed < size && (getline line) > 0) {
                    if (consumed == 0) first = line
                    consumed += length(line) + 1
                }
                if (type == "blob") print slot, oid, first
            }'
}

# Prints the slots acquire may take, best first, as "<group> <order> <slot> <old object id>":
# group 0 is a lease this worktree holds, group 1 a free slot, and group 2 a lease of another
# live worktree ordered by the time it was renewed. The old object id is 0 for a slot without a ref.
candidates () {
    local self="$1" work
    work="$(mktemp -d)"
    live_worktrees > "${work}/live"
    list_leases > "${work}/leases"
    awk -v live="${work}/live" -v self="${self}" -v first="${first_port}" \
        -v count="${slot_count}" -v skip="${skipped_ports}" '
        function skipped(slot,   base, i, n, parts, range, lo, hi) {
            base = first + 3 * slot
            n = split(skip, parts, " ")
            for (i = 1; i <= n; i++) {
                if (split(parts[i], range, "-") == 2) { lo = range[1]; hi = range[2] } else { lo = parts[i]; hi = parts[i] }
                if (base <= hi + 0 && base + 2 >= lo + 0) return 1
            }
            return 0
        }
        FILENAME == live { alive[$0] = 1; next }
        {
            path = $0
            sub(/^[^ ]+ [^ ]+ [^ ]+ /, "", path)
            leased[$1] = $2
            if (path == self) print 0, $1, $1, $2
            else if (path in alive) print 2, $3, $1, $2
            else stale[$1] = 1
        }
        END {
            for (slot = 0; slot < count; slot++) {
                if (skipped(slot)) continue
                if (!(slot in leased)) print 1, slot, slot, 0
                else if (slot in stale) print 1, slot, slot, leased[slot]
            }
        }' "${work}/live" "${work}/leases" | sort -k1,1n -k2,2n
    rm -rf "${work}"
}

acquire () {
    local self blob zero addresses group order slot old
    self="$(git rev-parse --show-toplevel)"
    blob="$(printf '%s %s\n' "$(date +%s)" "${self}" | git hash-object -w --stdin)"
    zero="$(printf '%s' "${blob}" | tr '0-9a-f' '0')"
    addresses="$(loopback_addresses)"
    while read -r group order slot old; do
        if [[ "${old}" == 0 ]]; then
            old="${zero}"
        fi
        # The server of this worktree may be running, so its own slot is taken even when busy.
        if [[ "${group}" != 0 ]] && slot_ports_in_use "${slot}" "${addresses}"; then
            continue
        fi
        # update-ref fails when the ref no longer points to the old object id, so two worktrees
        # acquiring at once never take the same slot.
        if git update-ref "${ref_prefix}/${slot}" "${blob}" "${old}" 2>/dev/null; then
            echo "${slot} $(slot_ports "${slot}")"
            return 0
        fi
    done < <(candidates "${self}")
    die "every slot from ${first_port} to $(( first_port + 3 * slot_count - 1 )) is skipped or has a port in use"
}

show () {
    local self group order slot old
    self="$(git rev-parse --show-toplevel)"
    while read -r group order slot old; do
        if [[ "${group}" == 0 ]]; then
            echo "${slot} $(slot_ports "${slot}")"
            return 0
        fi
    done < <(candidates "${self}")
}

release () {
    local self group order slot old
    self="$(git rev-parse --show-toplevel)"
    while read -r group order slot old; do
        if [[ "${group}" == 0 ]]; then
            git update-ref -d "${ref_prefix}/${slot}" "${old}"
        fi
    done < <(candidates "${self}")
}

main () {
    git rev-parse --show-toplevel > /dev/null 2>&1 || die "run it inside a git worktree"
    case "${1:-}" in
    acquire) acquire ;;
    show) show ;;
    release) release ;;
    addresses) loopback_addresses ;;
    *) die "usage: pg-port-lease acquire|show|release|addresses" ;;
    esac
}

main "$@"
